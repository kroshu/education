{
    "name": "ROS 2 Humble Workspace",
    "remoteUser": "rosdev",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "rosdev",
            "GID": "1000",
            "UID": "1000"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "ranch-hand-robotics.rde-ros-2"
            ],
            "settings": {
                "files.associations": {
                    "*.rviz": "yaml",
                    "*.srdf": "xml",
                    "*.urdf": "xml",
                    "*.xacro": "xml"
                }
            }
        }
    },
    "workspaceFolder": "/home/rosdev/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/rosdev/ros2_ws/src/VIIIAV55,type=bind",
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        // "type=bind,source=${localWorkspaceFolder}/.devcontainer/certs,target=/tmp/certs,readonly"
    ],
    // Only constants here: containerEnv is baked into the image at build time.
    "containerEnv": {
        "QT_X11_NO_MITSHM": "1",
        "LIBGL_ALWAYS_SOFTWARE": "0"
    },
    // Host-dependent values go here. DISPLAY is unset on a Windows host,
    // in which case .bashrc falls back to :0 (WSLg).
    "remoteEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    "runArgs": [
        "--net=host"
    ],
    "postCreateCommand": "bash src/VIIIAV55/.devcontainer/init-corporate-trust.sh && bash src/VIIIAV55/.devcontainer/download-ros-dependencies.sh"
}
